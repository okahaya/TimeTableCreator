{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "npm: dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*http://localhost"
        }
      }
    },
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "npm: build:electron",
      "type": "shell",
      "command": "npm run build && npx tsc -p electron/tsconfig.json",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "electron:dev",
      "label": "npm: electron:dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "electron:build",
      "label": "npm: electron:build",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
